{
  "name": "azenza-ecommerce",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/main-server.tsx --outDir dist/server",
    "generate:llms": "npx --no-install tsx scripts/generate-llms.ts",
    "generate:feed": "npx --no-install tsx scripts/generate-google-feed.ts",
    "generate:sitemap": "npx --no-install tsx scripts/generate-sitemap.ts",
    "generate:static": "npx --no-install tsx scripts/generate-static.ts",
    "build": "npm run generate:llms && npm run generate:feed && npm run generate:sitemap && npm run build:client && npm run build:server && npm run generate:static",
    "lint": "npx --no-install tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.16.0",
    "motion": "^13.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vite": "^6.2.0"
  }
}
