# Cloudflare Pages Custom Headers for Cache & Performance Optimization

# 1. Static Assets with Hash (Vite bundle output) - 1 Year Inmutable Cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# 2. Images, Icons, Favicons, WebP - 1 Month Cache
/assets/products/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/assets/combos/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/assets/logo/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/assets/categories/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/assets/partners/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# 3. HTML Documents - Cache at Edge (Cloudflare CDN) with revalidation
/*.html
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=3600
  X-Content-Type-Options: nosniff
/
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=3600
  X-Content-Type-Options: nosniff

# 4. Sitemaps, Robots and Feeds
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
/google-feed.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *
/merchant-feed.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *
